rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function personaDoc(personaId) {
      return get(/databases/$(database)/documents/personas/$(personaId)).data;
    }

    function esTitular(personaId) {
      return estaAutenticado() && personaDoc(personaId).uidTitular == request.auth.uid;
    }

    function tieneAccesoCompartido(personaId) {
      return estaAutenticado() &&
        'uidsConAcceso' in personaDoc(personaId) &&
        request.auth.uid in personaDoc(personaId).uidsConAcceso;
    }

    function puedeEscribirCompartido(personaId) {
      return tieneAccesoCompartido(personaId) &&
        personaDoc(personaId).get('modoAccesoCompartido', 'lectura') == 'escritura';
    }

    // "¿Puede ver este perfil?" — titular o alguien con acceso compartido (sección 6).
    function tieneAcceso(personaId) {
      return esTitular(personaId) || tieneAccesoCompartido(personaId);
    }

    // "¿Puede cargar/editar datos de este perfil?"
    function puedeEscribir(personaId) {
      return esTitular(personaId) || puedeEscribirCompartido(personaId);
    }

    match /usuarios/{uid} {
      allow read, create, delete: if estaAutenticado() && request.auth.uid == uid;
      // personaYoMismoId (sección 6.2): una vez fijado, no se puede reescribir a
      // otro id — es el candado que usa `personas/{personaId}` para bloquear
      // una segunda Persona "yo mismo/a" de la misma cuenta (ver esa regla).
      allow update: if estaAutenticado() && request.auth.uid == uid &&
        (!('personaYoMismoId' in resource.data) ||
         request.resource.data.personaYoMismoId == resource.data.personaYoMismoId);
    }

    // Índice de unicidad de RUT (secciones 6.1 y 6.2): el id del doc ES el
    // RUT normalizado, así que un segundo "create" sobre el mismo RUT en
    // realidad es un "update" para Firestore — y update está bloqueado acá,
    // lo que impide reclamar dos veces el mismo RUT (como cuenta, como
    // dependiente, o ambos) sin depender de una Cloud Function. Dos formas
    // de documento según quién lo reclama: tipo 'titular' (uid propio, al
    // completar el registro) o 'dependiente' (uidTitular + personaId, al
    // crear una Persona menor_a_cargo/adulto_mayor_a_cargo).
    match /rutsRegistrados/{rut} {
      allow read: if false;
      allow create: if estaAutenticado() && (
        (request.resource.data.tipo == 'titular' && request.resource.data.uid == request.auth.uid) ||
        (request.resource.data.tipo == 'dependiente' && request.resource.data.uidTitular == request.auth.uid)
      );
      allow update: if false;
      // resource.data.get('tipo','titular'): los docs ya existentes de antes de
      // esta regla no tienen campo "tipo" — se tratan como 'titular'.
      allow delete: if estaAutenticado() && (
        (resource.data.get('tipo', 'titular') == 'titular' && resource.data.uid == request.auth.uid) ||
        (resource.data.get('tipo', 'titular') == 'dependiente' && resource.data.uidTitular == request.auth.uid)
      );
    }

    // PIN de acceso compartido (sección 6): el id del doc ES el PIN, así que dos
    // PIN iguales vigentes son imposibles (un segundo "create" sería un update,
    // bloqueado). Solo el titular de la Persona puede crearlo, verlo o
    // revocarlo — quien tiene acceso compartido nunca lo lee, así no puede
    // reenviarlo. Vencimiento máximo 7 días y 1–5 usos; el canje y el conteo
    // de usos los hace la Cloud Function canjearPin con el Admin SDK.
    match /pinesAcceso/{pin} {
      allow read, delete: if estaAutenticado() && resource.data.uidTitular == request.auth.uid;
      allow create: if estaAutenticado() &&
        pin.matches('^[0-9]{6}$') &&
        request.resource.data.uidTitular == request.auth.uid &&
        esTitular(request.resource.data.personaId) &&
        request.resource.data.usos == 0 &&
        request.resource.data.usosMax is int &&
        request.resource.data.usosMax >= 1 && request.resource.data.usosMax <= 5 &&
        request.resource.data.modo in ['lectura', 'escritura'] &&
        request.resource.data.expiraEn is timestamp &&
        request.resource.data.expiraEn <= request.time + duration.value(7, 'd') + duration.value(5, 'm');
      allow update: if false;
    }

    match /personas/{personaId} {
      allow read: if estaAutenticado() &&
        (resource.data.uidTitular == request.auth.uid ||
         request.auth.uid in resource.data.get('uidsConAcceso', []));
      // Sección 6.2: una cuenta nunca puede tener dos Personas "yo mismo/a" — se
      // bloquea leyendo usuarios/{uid}.personaYoMismoId, que el mismo batch que
      // crea esta Persona fija de forma atómica (ver PersonasService.crearTitular).
      // Cuentas que ya tenían su "yo mismo/a" antes de esta regla (sin ese campo
      // todavía) quedan protegidas recién la primera vez que esto se evalúa.
      allow create: if estaAutenticado() && request.resource.data.uidTitular == request.auth.uid &&
        (request.resource.data.relacion != 'yo_mismo' ||
         !('personaYoMismoId' in get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data));
      // Quien solo tiene acceso compartido nunca puede tocar la titularidad, el PIN
      // ni la lista de accesos: eso se administra únicamente vía Cloud Functions.
      allow update: if esTitular(personaId) ||
        (puedeEscribirCompartido(personaId) &&
         request.resource.data.uidTitular == resource.data.uidTitular &&
         request.resource.data.get('uidsConAcceso', []) == resource.data.get('uidsConAcceso', []) &&
         request.resource.data.get('pinAccesoCompartido', null) == resource.data.get('pinAccesoCompartido', null));
      allow delete: if esTitular(personaId);

      // Historial clínico: append-only, sin excepciones (sección 3.3 y 7 del spec).
      match /historialMedico/{entradaId} {
        allow read: if tieneAcceso(personaId);
        allow create: if puedeEscribir(personaId) &&
          request.resource.data.autorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Resto de subcolecciones: CRUD normal para quien tiene acceso al perfil.
      match /{coleccion}/{itemId} {
        allow read: if tieneAcceso(personaId) &&
          coleccion in ['vacunas', 'medicamentosActivos', 'citas', 'examenes', 'documentos', 'especialidades'];
        allow create, update, delete: if puedeEscribir(personaId) &&
          coleccion in ['vacunas', 'medicamentosActivos', 'citas', 'examenes', 'documentos', 'especialidades'];
      }
    }

    // Reglas espejo para collectionGroup: el bloque anidado de arriba solo cubre
    // consultas directas a la subcolección de UNA persona (personas/{id}/vacunas).
    // Home y Agenda agregan vacunas/citas/medicamentosActivos de TODAS las
    // personas de la cuenta en una sola consulta (sección 4.5 del spec), y
    // Firestore exige un bloque aparte con el wildcard recursivo {path=**}
    // para que las reglas se apliquen a ese tipo de consulta.
    //
    // En vez de resolver la persona dueña con un get() (la interpolación del
    // wildcard recursivo en un path de get()/exists() no funcionó de forma
    // confiable, probado contra el emulador), se usa directamente
    // `creadoPor`: ya es el mismo filtro que usan estas consultas en el
    // cliente (HomeService/AgendaPage piden where('creadoPor','==',uid)), así
    // que la regla queda provablemente correcta para la consulta real y sin
    // necesitar una lectura extra.
    match /{path=**}/vacunas/{itemId} {
      allow read: if estaAutenticado() && resource.data.creadoPor == request.auth.uid;
    }
    match /{path=**}/medicamentosActivos/{itemId} {
      allow read: if estaAutenticado() && resource.data.creadoPor == request.auth.uid;
    }
    match /{path=**}/citas/{itemId} {
      allow read: if estaAutenticado() && resource.data.creadoPor == request.auth.uid;
    }
  }
}
